# Public API base URL (no secrets here).
# Empty = same-origin: requests go to /api/v1 on the site and Netlify proxies
# them to the Render backend (see netlify.toml). This avoids CORS in production.
# Keep it empty unless the API is served from a different origin you control.
VITE_API_URL=

# Servicio de Machine Learning (DiaMonitor).
# En development Vite redirige /ml al target (ver vite.config.js).
# En production apunta directo al servicio (Railway) o se puede enrutar por
# el redirect /ml/* de Netlify (ver netlify.toml).
#
# IMPORTANTE (producción/Netlify): las variables VITE_* se inyectan DURANTE el
# build y el archivo .env NO se sube al repositorio (está en .gitignore). Por
# eso VITE_ML_API_URL debe definirse en las variables de entorno del dashboard
# de Netlify (o CI) y después se debe volver a hacer deploy/build. Si falta, el
# build usa la URL por defecto https://dialitechmlservice-production.up.railway.app
# (ver ml.service.js), por lo que NUNCA se genera "undefined/api/v1/analyze".
VITE_ML_API_URL=https://dialitechmlservice-production.up.railway.app

# ADVERTENCIA DE SEGURIDAD: VITE_* se embarca en el bundle del frontend, por lo
# que ESTA CLAVE NO ES UN SECRETO REAL EN PRODUCCIÓN. Queda expuesta al cliente.
# La solución segura es un proxy backend propio que inyecte X-API-Key en el
# servidor (Frontend -> proxy -> ML Service). Déjala vacía si el proxy la inyecta.
VITE_ML_API_KEY=
