# Public API base URL (no secrets here).
# Empty = same-origin: requests go to /api/v1 on the site and Netlify proxies
# them to the Render backend (see netlify.toml). This avoids CORS in production.
# Keep it empty unless the API is served from a different origin you control.
VITE_API_URL=

# Servicio de Machine Learning (DiaMonitor) - CONFIGURACIÓN DEL SERVIDOR (Netlify Environment Variables)
# NO usar prefijo VITE_* para estas variables: deben estar SOLO en el entorno del servidor (Netlify Functions).
# Configúralas en Netlify Dashboard > Site settings > Environment variables.
#
# ML_API_URL=https://dialitechmlservice-production.up.railway.app
# ML_API_KEY=tu-clave-secreta-del-servicio-ml (NUNCA commitear, NUNCA usar prefijo VITE_)
#
# En desarrollo local con `netlify dev`:
# Crea un archivo .env.local (en .gitignore) con:
# ML_API_URL=https://dialitechmlservice-production.up.railway.app
# ML_API_KEY=tu-clave-de-desarrollo
#
# El cliente llama a /ml/* (same-origin via Netlify redirect /ml/* -> /.netlify/functions/ml-proxy/*)
# La Netlify Function inyecta X-API-Key desde ML_API_KEY y reenvía al servicio ML.
# La API key NUNCA llega al bundle del navegador ni al cliente.

# NOTA: VITE_ML_API_URL y VITE_ML_API_KEY YA NO SE USAN en el cliente.
# Se mantienen comentadas solo como referencia histórica.
# VITE_ML_API_URL=
# VITE_ML_API_KEY=