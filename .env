# Same-origin base: requests go to /api/v1 on the site and Netlify proxies them
# to https://api-dialitech-core-v2.onrender.com (see netlify.toml). This avoids CORS.
VITE_API_URL=

# Patient Monitoring dashboard:
# true  -> use simulated datasets (no network calls). Set this until the
#          /dashboard/monitoring/* endpoints are live.
# false -> query the API and fall back to simulated data on error.
VITE_USE_MOCK_DATA=true
