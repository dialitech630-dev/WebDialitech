# Same-origin base: requests go to /api/v1 on the site and Netlify proxies them
# to https://api-dialitech-core-v2.onrender.com (see netlify.toml). This avoids CORS.
VITE_API_URL=

# Servicio de ML (DiaMonitor). En dev Vite redirige /ml hacia el target.
VITE_ML_API_URL=https://dialitechmlservice-production.up.railway.app
# ATENCIÓN: es una VITE_* y se incluye en el bundle => NO es secreto en producción.
# La clave queda expuesta al cliente (no existe proxy backend propio aún).
VITE_ML_API_KEY=test-key
